# Tuut-Einstellungen. SERVER-START legt daraus beim ersten Start die Datei
#   C:\Users\<dein Name>\Tuut\einstellungen.env
# an – außerhalb des Projektordners, damit sie nie zu GitHub hochgeladen wird.
# Dort trägst du deine Schlüssel ein. Diese Vorlage selbst bleibt leer.
# Nach jeder Änderung SERVER-START erneut doppelklicken.

# --- Stripe (Guthaben aufladen) ---------------------------------------------
# Stripe-Dashboard -> Entwickler -> API-Schlüssel -> "Geheimer Schlüssel".
# Zum Ausprobieren den Testschlüssel (beginnt mit sk_test_), für echtes Geld sk_live_.
STRIPE_SECRET_KEY=
# Nur für den öffentlichen Server (Webhook). Lokal leer lassen.
STRIPE_WEBHOOK_SECRET=

# Adresse, unter der dieser Dienst erreichbar ist (Rücksprung nach der Zahlung).
PUBLIC_BASE_URL=http://localhost:8787

# --- Festnetz ----------------------------------------------------------------
# "aus", bis ein Telefonie-Anbieter angebunden ist.
TELEFONIE_ANBIETER=aus
ANBIETER_WEBHOOK_SECRET=

# --- Schutz vor Missbrauch (Beträge in Cent) --------------------------------
MAX_RESERVIERUNG_CENT=1000
TAGESLIMIT_CENT=2000
MAX_PARALLELE_GESPRAECHE=1
